<?php
use Yotpo\Reviews\Block\Conversion;
use Magento\Framework\Escaper;

/**
 * @var $block Conversion
 * @var Escaper $escaper
 */
$escaper = $escaper ?? $block;
?>
<?php if (!($block->isEnabled() && $block->hasOrder())) {
    return;
} ?>
<!-- Yotpo - Conversion -->
<?php if (($jsonData = $block->getJsonData())): ?>
    <script>
        (function e(){
            let e=document.createElement("script");
            e.type="text/javascript",
            e.async=true,
            e.src="<?= $escaper->escapeUrl($block->getYotpoWidgetUrl()) ?>";
            let t=document.getElementsByTagName("script")[0];t.parentNode.insertBefore(e,t)})();
    </script>
    <script>
        yotpoTrackConversionData = <?= /* @noEscape */ $jsonData ?>;
    </script>
<?php endif; ?>
<?php if (($noScriptSrc = $block->getNoscriptSrc())): ?>
    <noscript>
        <img src="<?= $escaper->escapeUrl($noScriptSrc) ?>" width="1" height="1">
    </noscript>
<?php endif; ?>
<!--/ Yotpo - Conversion -->
